@model List<WarehouseWeb.Models.Supplier>

@{
    ViewData["Title"] = "Постачальники";
    var currentUser = WarehouseWeb.Controllers.AuthController.GetCurrentUser(Context);
    var canManage = string.Equals(currentUser?.Role?.Name, WarehouseWeb.Models.RoleNames.Owner, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(currentUser?.Role?.Name, WarehouseWeb.Models.RoleNames.Manager, StringComparison.OrdinalIgnoreCase);
}

<section class="page-hero">
    <h1 class="page-title">Постачальники</h1>
    <p class="page-subtitle">Реєстр постачальників, контактні дані, умови співпраці та історія поставок.</p>
</section>

@if (canManage)
{
    <div class="actions-row">
        <a href="/Supplier/Create" class="btn-brand">Додати постачальника</a>
        <a href="/Purchase/Create" class="btn-muted">Нова закупівля</a>
    </div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">Постачальників ще не додано.</div>
}
else
{
    <div class="table-wrap panel p-0">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Назва</th>
                    <th>Контакт</th>
                    <th>Email / Телефон</th>
                    <th>Статус</th>
                    <th>Договорів</th>
                    <th>Поставок</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td><strong>@supplier.Name</strong></td>
                        <td>@(string.IsNullOrWhiteSpace(supplier.ContactPerson) ? "—" : supplier.ContactPerson)</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(supplier.Email) ? "—" : supplier.Email)<br />
                            <span class="form-note">@(string.IsNullOrWhiteSpace(supplier.Phone) ? "—" : supplier.Phone)</span>
                        </td>
                        <td>
                            @if (supplier.IsActive)
                            {
                                <span class="badge-soft badge-ok">Активний</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-muted">Неактивний</span>
                            }
                        </td>
                        <td>@supplier.Contracts.Count</td>
                        <td>@supplier.Purchases.Count</td>
                        <td>
                            <a href="/Supplier/Details/@supplier.Id" class="action-link">Деталі</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
