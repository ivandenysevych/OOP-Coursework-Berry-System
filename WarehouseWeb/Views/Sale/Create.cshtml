@{
    ViewData["Title"] = "Новий продаж";
    var products = ViewBag.Products as List<WarehouseWeb.Models.Product> ?? new List<WarehouseWeb.Models.Product>();
    var form = Context?.Request?.HasFormContentType == true ? Context.Request.Form : null;
    var selectedProductId = form?["productId"].ToString() ??
                            (ViewBag.SelectedProductId != null ? ViewBag.SelectedProductId.ToString() : string.Empty) ??
                            string.Empty;
    var saleDate = string.IsNullOrWhiteSpace(form?["saleDate"].ToString())
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        : form?["saleDate"].ToString();
}

<section class="page-hero">
    <h1 class="page-title">Реєстрація продажу</h1>
    <p class="page-subtitle">Оберіть товар, вкажіть кількість і систему автоматично спише залишок зі складу.</p>
</section>

<div class="panel" style="max-width: 980px;">
    @if (ViewBag.Error != null)
    {
        <div class="alert-error">@ViewBag.Error</div>
    }

    <form method="post" class="form-grid">
        <div>
            <label class="form-label" for="productId">Товар</label>
            <select id="productId" name="productId" required>
                <option value="">Оберіть товар</option>
                @foreach (var product in products)
                {
                    <option value="@product.Id" selected="@(selectedProductId == product.Id.ToString() ? "selected" : null)">
                        @product.Name (@product.Quantity @product.Unit)
                    </option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="saleDate">Дата продажу</label>
            <input id="saleDate" name="saleDate" type="datetime-local" value="@saleDate" required />
        </div>

        <div>
            <label class="form-label" for="quantity">Кількість</label>
            <input id="quantity" name="quantity" type="number" step="0.001" min="0.001" required value="@(form?["quantity"].ToString() ?? string.Empty)" />
        </div>

        <div>
            <label class="form-label" for="unitPrice">Ціна за одиницю</label>
            <input id="unitPrice" name="unitPrice" type="number" step="0.01" min="0" required value="@(form?["unitPrice"].ToString() ?? string.Empty)" />
        </div>

        <div>
            <label class="form-label" for="customerName">Клієнт (опційно)</label>
            <input id="customerName" name="customerName" maxlength="180" value="@(form?["customerName"].ToString() ?? string.Empty)" />
        </div>

        <div>
            <label class="form-label" for="invoiceNumber">Номер накладної (опційно)</label>
            <input id="invoiceNumber" name="invoiceNumber" maxlength="80" value="@(form?["invoiceNumber"].ToString() ?? string.Empty)" />
        </div>

        <div class="full">
            <label class="form-label" for="paymentTerms">Умови оплати</label>
            <textarea id="paymentTerms" name="paymentTerms" maxlength="600">@(form?["paymentTerms"].ToString() ?? string.Empty)</textarea>
        </div>

        <div class="full">
            <label class="form-label" for="notes">Коментар</label>
            <textarea id="notes" name="notes" maxlength="600">@(form?["notes"].ToString() ?? string.Empty)</textarea>
        </div>

        <div class="full actions-row mb-0">
            <button type="submit" class="btn-brand">Зберегти продаж</button>
            <a href="/Sale" class="btn-muted">Скасувати</a>
        </div>
    </form>
</div>
