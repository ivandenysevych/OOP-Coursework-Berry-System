@model WarehouseWeb.Models.Product

@{
    ViewData["Title"] = "Редагування товару";
    var zones = ViewBag.Zones as List<WarehouseWeb.Models.StorageZone> ?? new List<WarehouseWeb.Models.StorageZone>();
    int? selectedZoneId = ViewBag.SelectedZoneId as int?;
}

<section class="page-hero">
    <h1 class="page-title">Редагування товару</h1>
    <p class="page-subtitle">Оновіть інформацію та за потреби змініть зону зберігання.</p>
</section>

<div class="panel" style="max-width: 900px;">
    @if (ViewBag.Error != null)
    {
        <div class="alert-error">@ViewBag.Error</div>
    }

    <form method="post" class="form-grid">
        <input type="hidden" name="id" value="@Model.Id" />

        <div>
            <label class="form-label" for="name">Назва</label>
            <input id="name" type="text" name="name" value="@Model.Name" required />
        </div>

        <div>
            <label class="form-label" for="category">Категорія</label>
            <input id="category" type="text" name="category" value="@Model.Category" required />
        </div>

        <div>
            <label class="form-label" for="quantity">Кількість</label>
            <input id="quantity" type="number" step="0.001" name="quantity" min="0" value="@Model.Quantity" required />
        </div>

        <div>
            <label class="form-label" for="price">Ціна</label>
            <input id="price" type="number" step="0.01" name="price" min="0" value="@Model.Price" required />
        </div>

        <div>
            <label class="form-label" for="unit">Одиниця виміру</label>
            <select id="unit" name="unit">
                @if (Model.Unit == "kg")
                {
                    <option value="kg" selected>kg (кілограми)</option>
                }
                else
                {
                    <option value="kg">kg (кілограми)</option>
                }

                @if (Model.Unit == "g")
                {
                    <option value="g" selected>g (грами)</option>
                }
                else
                {
                    <option value="g">g (грами)</option>
                }

                @if (Model.Unit == "pcs")
                {
                    <option value="pcs" selected>pcs (штуки)</option>
                }
                else
                {
                    <option value="pcs">pcs (штуки)</option>
                }

                @if (Model.Unit == "box")
                {
                    <option value="box" selected>box (ящики)</option>
                }
                else
                {
                    <option value="box">box (ящики)</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="zoneId">Зона зберігання</label>
            <select id="zoneId" name="zoneId">
                <option value="">Без прив'язки</option>
                @foreach (var zone in zones)
                {
                    var isSelected = selectedZoneId == zone.Id;

                    if (isSelected)
                    {
                        <option value="@zone.Id" selected>@zone.Name (@zone.Type) - @zone.Warehouse?.Name</option>
                    }
                    else
                    {
                        <option value="@zone.Id">@zone.Name (@zone.Type) - @zone.Warehouse?.Name</option>
                    }
                }
            </select>
        </div>

        <div class="full actions-row mb-0">
            <button type="submit" class="btn-brand">Зберегти зміни</button>
            <a href="/Product" class="btn-muted">Назад</a>
        </div>
    </form>
</div>
