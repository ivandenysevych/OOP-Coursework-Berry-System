@{
    ViewData["Title"] = "Меню управління";
}

<section class="page-hero">
    <h1 class="page-title">Головне меню управління компанією</h1>
    <p class="page-subtitle">
        Оберіть модуль для щоденної роботи: компанії, склад, закупівлі, рухи товарів та аналітика.
    </p>
</section>

<div class="kpi-grid mb-3">
    <article class="kpi-card">
        <p class="kpi-label">Компанії</p>
        <p class="kpi-value">Структура та ролі</p>
        <a class="action-link" href="/Company">Керувати компаніями</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Товари</p>
        <p class="kpi-value">Залишки та ціни</p>
        <a class="action-link" href="/Product">Перейти до товарів</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Постачальники</p>
        <p class="kpi-value">Контакти та договори</p>
        <a class="action-link" href="/Supplier">Відкрити постачальників</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Закупівлі</p>
        <p class="kpi-value">Журнал поставок</p>
        <a class="action-link" href="/Purchase">Відкрити закупівлі</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Заготівлі</p>
        <p class="kpi-value">Приймання від населення</p>
        <a class="action-link" href="/Procurement">Відкрити заготівлі</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Продажі</p>
        <p class="kpi-value">Журнал реалізації</p>
        <a class="action-link" href="/Sale">Відкрити продажі</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Рухи товару</p>
        <p class="kpi-value">Надходження та переміщення</p>
        <a class="action-link" href="/Movement">Перейти до рухів</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Фінанси</p>
        <p class="kpi-value">Баланси та видача коштів</p>
        <a class="action-link" href="/Finance">Відкрити фінанси</a>
    </article>

    <article class="kpi-card">
        <p class="kpi-label">Аналітика</p>
        <p class="kpi-value">Звіти та метрики</p>
        <a class="action-link" href="/Analytics">Відкрити аналітику</a>
    </article>
</div>

<div class="panel">
    <h2 class="section-title">Рекомендований порядок роботи</h2>
    <ol class="list-clean">
        <li>Створіть компанію та структуру складів із зонами зберігання.</li>
        <li>Додайте постачальників і зафіксуйте договори постачання.</li>
        <li>Фіксуйте заготівлі від населення в окремому журналі.</li>
        <li>Розподіліть бюджети між компанією, складами і заготівельниками.</li>
        <li>Зареєструйте закупівлі й оприбуткуйте продукцію на склад.</li>
        <li>Фіксуйте продажі та відстежуйте рухи товарів і показники в аналітиці.</li>
    </ol>
</div>
